; Side-set pin 0 is the PWM output.
; FIFO word 0 is the match threshold (X). FIFO word 1 is the period (ISR).
; Y counts down from the period through 0. The pin is forced low at the start
; of each period, goes high on the single iteration where X == Y, and stays
; high until the next period. The low path must not side-set, or the output
; collapses to a one-tick pulse. C programs X = high_iterations - 1.
.pio_version 0

.program generator
.side_set 1 opt

    pull block      side 0
    mov x, osr
    pull block      side 0
    mov isr, osr
restart:
    mov y, isr
countloop:
    jmp x!=y noset
    jmp skip        side 1
noset:
    nop
skip:
    jmp y-- countloop
    jmp restart     side 0

% c-sdk {
static inline void generator_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_config config = generator_program_get_default_config(offset);
    sm_config_set_sideset_pins(&config, pin);
    pio_sm_init(pio, sm, offset, &config);
}
%}